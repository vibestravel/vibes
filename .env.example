# ── Database ─────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/vibes_ai"

# ── Security ─────────────────────────────────────────────
# Random 32+ char string: openssl rand -base64 48
SESSION_SECRET=""

# ── File storage ─────────────────────────────────────────
STORAGE_DIR="/var/lib/vibes-ai/storage"
# Public base URL of this app (used for secure document links)
APP_URL="https://ai.vibestraveleg.com"

# ── AI ───────────────────────────────────────────────────
# Leave empty to run the clearly labeled DEMO engine (no real AI).
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5-5"

# ── FlexiVi ──────────────────────────────────────────────
# FLEXIVI_MODE: mock | live   (live only after the FlexiVi team ships the API in docs/FLEXIVI_API_SPEC.md)
FLEXIVI_MODE="mock"
FLEXIVI_BASE_URL=""
FLEXIVI_API_KEY=""
FLEXIVI_HMAC_SECRET=""
FLEXIVI_AVAILABILITY_MAX_AGE_MIN="30"

# ── Meta (Instagram / Messenger) ─────────────────────────
META_APP_SECRET=""
META_VERIFY_TOKEN=""
META_PAGE_ACCESS_TOKEN=""

# ── WhatsApp Cloud API ───────────────────────────────────
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
